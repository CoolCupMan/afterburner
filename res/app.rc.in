#include <windows.h>

1 ICON "@KEY@.ico"
1 RT_MANIFEST "@KEY@.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERC@
PRODUCTVERSION @VERC@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CoolCupMan"
      VALUE "FileDescription", "@NAME@"
      VALUE "FileVersion", "@VER@"
      VALUE "InternalName", "@KEY@"
      VALUE "OriginalFilename", "@KEY@.exe"
      VALUE "ProductName", "Afterburner Suite - @NAME@"
      VALUE "ProductVersion", "@VER@"
      VALUE "Comments", "AppUserModelID @AUMID@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
